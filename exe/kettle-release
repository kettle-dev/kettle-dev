      Kettle::Dev::ExitAdapter.abort("--ci-workflows requires a comma-separated workflow list")
    end
    argv.slice!(idx, 2)
  end
  argv.delete_if do |arg|
    if arg.start_with?("--ci-workflows=", "ci_workflows=")
